{
  "name": "collage",
  "version": "0.2.0",
  "description": "Collage, story and border maker for photos",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Collage",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
